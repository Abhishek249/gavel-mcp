Output assets/gavel-demo.gif

Set Shell "bash"
Set FontSize 22
Set FontFamily "JetBrains Mono"
Set Width 1200
Set Height 720
Set Padding 24
Set Framerate 30
Set TypingSpeed 35ms
Set Theme { "name": "Gavel", "black": "#081426", "red": "#ff5f6d", "green": "#20d6a5", "yellow": "#f5c451", "blue": "#21b8f6", "magenta": "#7955ff", "cyan": "#20e0d0", "white": "#e8f0ff", "brightBlack": "#52647f", "brightRed": "#ff8190", "brightGreen": "#48edba", "brightYellow": "#ffda75", "brightBlue": "#58caff", "brightMagenta": "#9a7cff", "brightCyan": "#6bf2e6", "brightWhite": "#ffffff", "background": "#081426", "foreground": "#e8f0ff", "selection": "#203653", "cursor": "#20e0d0" }

Type "python scripts/demo_live.py"
Enter
Sleep 11s
